NODE_ENV=production
PORT=3000
TENANT_SLUG=grupo-aga
# No Railway: vincule o serviço Postgres e Redis (DATABASE_URL e REDIS_URL vêm
# automaticamente das variáveis de ambiente do Railway quando há binding).
DATABASE_URL=postgresql://aga:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/aga?schema=public
REDIS_URL=redis://redis:6379

# Gere segredos aleatórios fortes. Nunca reutilize entre ambientes.
JWT_ACCESS_SECRET=CHANGE_ME_WITH_AT_LEAST_64_RANDOM_CHARACTERS________________________________
JWT_ISSUER=grupo-aga-api
JWT_AUDIENCE=grupo-aga-apps
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_DAYS=30

# Chave base64 de 32 bytes para AES-256-GCM.
FIELD_ENCRYPTION_KEY_BASE64=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
TRACKING_WEBHOOK_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
PAYMENT_WEBHOOK_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
PAYMENT_PROVIDER_MODE=sandbox
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
ADMIN_MFA_REQUIRED=false

# Somente para seed local. Trocar no primeiro acesso.
SEED_ADMIN_EMAIL=admin@aga.local
SEED_ADMIN_PASSWORD=CHANGE_ME_Admin_2026!
SEED_MERCHANT_EMAIL=lojista@aga.local
SEED_MERCHANT_PASSWORD=CHANGE_ME_Lojista_2026!
SEED_CLIENT_EMAIL=cliente@aga.local
SEED_CLIENT_PASSWORD=CHANGE_ME_Cliente_2026!
